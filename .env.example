# 本番URL（canonical / OGP の絶対URL生成に使用）
NEXT_PUBLIC_SITE_URL=https://recruit.example.co.jp

# 応募フォームの送信先。未設定の場合、フォームは送信せず「未設定」と表示します。
# JSON を POST できるエンドポイントを指定してください。
# NEXT_PUBLIC_ENTRY_ENDPOINT=https://example.com/api/entry

# 動画（YouTube）。src/data/videos.ts に直接URLを書く代わりに、ここで指定できます。
# 設定されていればコード側の値より優先されます。限定公開(Unlisted)のURLで動きます。
# NEXT_PUBLIC_VIDEO_COMPANY_TOUR=https://youtube.com/shorts/XXXXXXXXXXX
# NEXT_PUBLIC_VIDEO_ONE_DAY=https://youtube.com/shorts/XXXXXXXXXXX
# NEXT_PUBLIC_VIDEO_CEO_MESSAGE=https://youtube.com/shorts/XXXXXXXXXXX
# NEXT_PUBLIC_VIDEO_STAFF_INTERVIEW=https://youtube.com/shorts/XXXXXXXXXXX
